# Serveur web de production : HTTPS automatique (Let's Encrypt), pages statiques du jeu et de
# l'admin, sprites servis depuis le disque, et /api transmis à l'API Node.
# Les valeurs par défaut ({$VAR:défaut}) sont celles de l'image Docker ; les variables permettent
# de tester ce fichier hors de Docker.
{
	email {$ACME_EMAIL}
}

# /api sur chaque domaine : les pages appellent l'API sur leur propre origine (cookies de session).
(api) {
	handle_path /api/sprites/* {
		root * {$SPRITES_ROOT:/srv/sprites}
		# Une image ne change jamais à URL égale (retouche = nouveau ?v=) : cache d'un an.
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /api/* {
		# Pendant le redémarrage de l'API (mise en ligne), Caddy garde la requête jusqu'à 20 s au lieu
		# de répondre 502. Seules les connexions refusées sont retentées : une action déjà reçue par
		# l'API n'est jamais envoyée deux fois.
		reverse_proxy {$API_UPSTREAM:api:3000} {
			lb_try_duration 20s
			lb_try_interval 250ms
		}
	}
}

# Application monopage : fichiers de Vite, sinon index.html (navigation côté client).
(app) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# HTTPS seulement pendant un an, sous-domaines compris (pas encore de préchargement).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Jamais affiché dans une iframe d'un autre site (détournement de clic). Doublé par
		# frame-ancestors, ignoré tant que la politique n'est qu'en observation.
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Politique de contenu, d'abord en observation (violations dans la console du navigateur),
		# à appliquer ensuite (Content-Security-Policy) : voir docs/plans/PLAN-SECURITE.md, 1.3.
		# L'empreinte est celle du script de thème d'apps/web/index.html : scripts/csp-check.mjs
		# (CI) vérifie qu'elle correspond au jeu construit. blob: = fond d'ombres des Pokémon,
		# data: = petites polices et images intégrées par Vite. Seule violation attendue :
		# « script-src eval » au chargement, sonde Function('') de Zod, qui se passe alors de
		# compilation (pas de 'unsafe-eval'). challenges.cloudflare.com : captcha Turnstile (script et
		# cadre), chargé seulement si TURNSTILE_SITE_KEY est rempli.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-8yiyusYYzhHlRKhbQmdoOZa+Whj50miuJA1p3AsfFZ4=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
	import api
	handle {
		root * {args[0]}
		# Fichiers de Vite nommés d'après leur contenu : jamais modifiés, cache d'un an.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# Le reste (index.html, sw.js, manifeste) : toujours revalidé, pour voir les mises à jour.
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$SITE_DOMAIN} {
	# L'administration ne répond que sur son propre domaine : depuis le jeu, /api/admin n'existe
	# pas (le chemin le plus précis l'emporte sur le /api/* de l'extrait « api »).
	handle /api/admin/* {
		respond 404
	}
	import app {$WEB_ROOT:/srv/web}
}

{$ADMIN_DOMAIN} {
	import app {$ADMIN_ROOT:/srv/admin}
}
