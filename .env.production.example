# Réglages de production (VPS). Sur le serveur : copier ce fichier en .env à la racine du dépôt,
# puis remplir les valeurs. Ne jamais commiter le vrai .env.
# Générer un secret : openssl rand -hex 32

# --- Domaines (enregistrements DNS A vers l'IP du VPS)
SITE_DOMAIN=mondomaine.fr
ADMIN_DOMAIN=admin.mondomaine.fr
# Adresse prévenue par Let's Encrypt en cas de problème de certificat
ACME_EMAIL=moi@example.com

# --- Base de données (Postgres dans Docker). Hexadécimal : utilisable tel quel dans une URL.
POSTGRES_PASSWORD=

# --- Better Auth (BETTER_AUTH_URL et TRUSTED_ORIGINS sont déduits des domaines)
# Au moins 32 caractères (openssl rand -hex 32), sinon l'API refuse de démarrer.
BETTER_AUTH_SECRET=

# --- E-mails (réinitialisation du mot de passe), via la boîte e-mail OVH du domaine.
# Vide : pas de lien « Mot de passe oublié ? » dans le jeu.
# Exemple : smtps://contact%40mondomaine.fr:motdepasse@ssl0.ovh.net:465 (le @ de l'adresse et
# les caractères spéciaux du mot de passe encodés : @ → %40, : → %3A, / → %2F)
SMTP_URL=
# Expéditeur : la même adresse que l'identifiant SMTP (sinon OVH refuse l'envoi)
MAIL_FROM=Dexpedition <contact@mondomaine.fr>
# Avec SMTP_URL, un nouveau compte doit confirmer son adresse avant d'entrer ; 0 pour couper.
EMAIL_VERIFICATION=

# --- Captcha Cloudflare Turnstile (facultatif) sur inscription, connexion, mot de passe oublié.
# Clés sur dash.cloudflare.com → Turnstile, widget « Managed » pour SITE_DOMAIN et ADMIN_DOMAIN.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Connexion Google / Discord (facultatif : boutons affichés seulement si les deux sont remplis)
# Adresses de retour : https://<SITE_DOMAIN>/api/auth/callback/google (ou /discord)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Notifications Web Push (vides : désactivées). Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:moi@example.com
# Intervalle (secondes) de la tournée des notifications ; 0 = désactivée
PUSH_INTERVAL_SECONDS=60
# Tâches de fond réservées à un seul processus (notifications push, coffres de guilde) ; 0 = coupées.
# À laisser actif : l'API tourne en un seul processus.
BACKGROUND_JOBS=1

# --- Limites de requêtes /api par minute (0 = aucune) : par joueur (par IP sans session),
# puis par adresse IP toutes sessions confondues
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_PER_IP_PER_MINUTE=1500
# Budgets propres : lectures lourdes (collection, recherches, classements, fiches des autres),
# par joueur et par route ; écritures (POST, PUT, PATCH, DELETE) par joueur
RATE_LIMIT_HEAVY_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=300

# --- Copie des sauvegardes hors du VPS (deploy/backup.sh, voir docs/INSTALLATION-SERVEUR.md, 9)
# Remote rclone (ex. backup:poke-collect-backups) ; vide : les sauvegardes restent sur le VPS.
BACKUP_REMOTE=
# Clé publique age (age1…) qui chiffre la copie ; la clé privée n'est jamais sur le serveur.
# Vide : rien n'est envoyé (jamais de copie en clair).
BACKUP_AGE_RECIPIENT=
