# Réglages de production (VPS). Sur le serveur : copier ce fichier en .env à la racine du dépôt,
# puis remplir les valeurs. Ne jamais commiter le vrai .env.
# Générer un secret : openssl rand -hex 32

# --- Domaines (enregistrements DNS A vers l'IP du VPS)
SITE_DOMAIN=mondomaine.fr
ADMIN_DOMAIN=admin.mondomaine.fr
# Adresse prévenue par Let's Encrypt en cas de problème de certificat
ACME_EMAIL=moi@example.com

# --- Base de données (Postgres dans Docker). Hexadécimal : utilisable tel quel dans une URL.
POSTGRES_PASSWORD=

# --- Better Auth (BETTER_AUTH_URL et TRUSTED_ORIGINS sont déduits des domaines)
BETTER_AUTH_SECRET=

# --- Connexion Google / Discord (facultatif : boutons affichés seulement si les deux sont remplis)
# Adresses de retour : https://<SITE_DOMAIN>/api/auth/callback/google (ou /discord)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Notifications Web Push (vides : désactivées). Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:moi@example.com
# Intervalle (secondes) de la tournée des notifications ; 0 = désactivée
PUSH_INTERVAL_SECONDS=60

# --- Limite de requêtes /api par minute et par IP (0 = aucune)
RATE_LIMIT_PER_MINUTE=300
