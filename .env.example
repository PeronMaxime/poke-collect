# Base de données : laisser vide pour utiliser PGlite (Postgres embarqué, fichier dans .data/pglite).
# Avec Docker : docker compose up -d, puis :
# DATABASE_URL=postgres://poke:poke@localhost:5432/poke_collect
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=change-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# OAuth (optionnel : les fournisseurs ne sont activés que si les deux variables sont renseignées)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

API_PORT=3000
# Par défaut : 127.0.0.1 en dev, 0.0.0.0 en production
API_HOST=

# Notifications Web Push (clés VAPID). Générer une paire : npx web-push generate-vapid-keys
# Vides en dev : une paire est générée une fois dans .data/vapid.json. Vides en production : push désactivé.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Intervalle (secondes) de la tournée des notifications (expéditions, combats, œufs) ; 0 = désactivée.
PUSH_INTERVAL_SECONDS=60
